<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="page-content">
    <div class="container">
      <div class="page-header">
        <div>
          <h1 class="section-title">Favorites</h1>
          <p class="section-subtitle">
            Your saved countries for quick access.
            <span class="favorites-count" id="favoritesCount">0 saved</span>
          </p>
        </div>
        <button type="button" class="btn btn--danger btn--sm" id="clearFavoritesBtn" style="display: none;">
          Clear All
        </button>
      </div>

      <div id="favoritesContainer">
        <div class="empty-state glass-panel animate-fade-in stagger-1" id="favoritesEmpty">
          <div class="empty-state__icon" style="color: var(--color-warning); background: rgba(245, 158, 11, 0.08);" aria-hidden="true">
            <span class="fa-solid fa-star"></span>
          </div>
          <h2 class="empty-state__title">You haven't added any favorite countries yet.</h2>
          <p class="empty-state__text">Search for a country and click the heart icon to save it.</p>
          <a href="/" class="btn btn--primary">Explore Countries</a>
        </div>

        <div class="favorite-grid" id="favoritesGrid" style="display: none;"></div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/favorites.js"></script>
</body>
</html>
