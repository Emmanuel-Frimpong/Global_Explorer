<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="page-content">
    <div class="container">
      <%- include('partials/country-nav') %>

      <!-- Premium Campus Hero Banner (Visual Pexels Upgrade) -->
      <div class="campus-hero-banner animate-fade-in stagger-1">
        <div class="campus-hero-banner__bg" style="background-image: url('<%= campusHeaderImage %>');"></div>
        <div class="campus-hero-banner__overlay"></div>
        <div class="campus-hero-banner__content">
          <div class="campus-hero-banner__flag-container">
            <img src="<%= country.flag %>" alt="<%= country.flagAlt %>" class="campus-hero-banner__flag">
            <%- include('partials/favorite-btn') %>
          </div>
          <h1 class="campus-hero-banner__title">Universities in <%= country.name %></h1>
          <p class="campus-hero-banner__meta">Explore <%= resultCount %> visual profiles of premier academic institutions in <%= country.name %></p>
        </div>
      </div>

      <section class="search-section search-section--inline animate-fade-in stagger-2">
        <form class="search-form" method="GET" action="/country/<%= encodeURIComponent(country.slug) %>/universities" id="universitySearchForm">
          <input
            type="text"
            name="q"
            class="search-form__input"
            placeholder="Search universities by name..."
            aria-label="Search universities by name"
            value="<%= searchQuery %>"
            autocomplete="off"
          >
          <button type="submit" class="search-form__btn">Search</button>
          <% if (searchQuery) { %>
            <a href="/country/<%= encodeURIComponent(country.slug) %>/universities" class="btn btn--outline btn--sm">Clear</a>
          <% } %>
        </form>
      </section>

      <% if (universities.length === 0) { %>
        <div class="empty-state animate-fade-in stagger-3">
          <div class="empty-state__icon" aria-hidden="true">
            <span class="fa-solid fa-graduation-cap"></span>
          </div>
          <h2 class="empty-state__title">No universities found</h2>
          <p class="empty-state__text">
            Search for a country to discover universities.
          </p>
          <% if (searchQuery) { %>
            <a href="/country/<%= encodeURIComponent(country.slug) %>/universities" class="btn">View All Universities</a>
          <% } else { %>
            <a href="/country/<%= encodeURIComponent(country.slug) %>" class="btn btn--outline">Back to Overview</a>
          <% } %>
        </div>
      <% } else { %>
        <div class="university-grid" id="universityGrid">
          <% universities.forEach(function(university) { %>
            <article class="university-card animate-fade-in" data-name="<%= university.name.toLowerCase() %>">
              <div class="university-card__img-container">
                <img class="university-card__img" src="<%= university.image %>" alt="<%= university.name %> Campus" loading="lazy">
              </div>
              <div class="university-card__content">
                <div class="university-card__icon-row">
                  <div class="university-card__icon" aria-hidden="true">
                    <span class="fa-solid fa-building-columns"></span>
                  </div>
                  <h2 class="university-card__name"><%= university.name %></h2>
                </div>
                <div class="university-card__body">
                  <p class="university-card__country">
                    <span class="info-icon fa-solid fa-location-dot" aria-hidden="true"></span>
                    <%= university.country %>
                  </p>
                  <% if (university.stateProvince) { %>
                    <p class="university-card__state">
                      <span class="info-icon fa-solid fa-map-pin" aria-hidden="true"></span>
                      <%= university.stateProvince %>
                    </p>
                  <% } %>
                  <% if (university.domain) { %>
                    <p class="university-card__domain">
                      <span class="info-icon fa-solid fa-network-wired" aria-hidden="true"></span>
                      <%= university.domain %>
                    </p>
                  <% } %>
                </div>
                <div class="university-card__footer">
                  <% if (university.website) { %>
                    <a
                      href="<%= university.website %>"
                      class="btn btn--sm university-card__link"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Open website for <%= university.name %>"
                    >
                      <span class="fa-solid fa-link" aria-hidden="true" style="margin-right: 0.375rem;"></span>
                      Open Website
                    </a>
                  <% } else { %>
                    <span class="university-card__no-link">No website</span>
                  <% } %>
                </div>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/universities.js"></script>
</body>
</html>
